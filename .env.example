# PostgreSQL Configuration for Looker Migration
# Copy this file to .env and update with your credentials

# PostgreSQL Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=barcelona_housing
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# SQLite Database Path (source)
SQLITE_DB_PATH=data/processed/database.db

# Optional: PostgreSQL SSL settings
# POSTGRES_SSL_MODE=prefer
