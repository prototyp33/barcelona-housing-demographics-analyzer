# Ejemplo de configuración de secrets para Streamlit
# Copia este archivo a .streamlit/secrets.toml y ajusta según necesites

[logging]
# Habilitar logging a archivo
enabled = false  # Cambiar a true para habilitar

# Nivel de logging: "INFO" o "DEBUG"
level = "INFO"

# Mostrar métricas de rendimiento en el sidebar
show_performance = false  # Cambiar a true para mostrar métricas

# Nota: Los logs se guardan en data/logs/dashboard.log
